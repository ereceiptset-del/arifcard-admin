# Copy to .env for local development. Nothing here is a secret: the admin
# app holds no credentials. Never put passwords or test logins in any .env.

# The API. Local backend in development; production uses same-origin "/api"
# (.env.production), which Hosting rewrites to the shared Cloud Function.
VITE_API_BASE_URL=http://localhost:4000/api

# Where "Go to the Arifcard customer site" points on the Access denied screen.
# A fixed link only — no session or token is ever handed to it.
VITE_CUSTOMER_SITE_URL=https://addiscard-1a9bc.web.app
