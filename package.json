{
  "name": "arifcard-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "lint": "oxlint src packages",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "deploy": "npm run build && node scripts/check-bundle.mjs && firebase deploy --only hosting:admin --project addiscard-1a9bc",
    "emulate": "firebase emulators:start --only hosting --project addiscard-1a9bc"
  },
  "dependencies": {
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
